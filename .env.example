# Copy to `.env` (already gitignored) and fill in real values.
# main.py auto-loads this file at startup (vdriftbench/env_loader.py) —
# no `export`/`source` needed. Values already present in the shell
# environment always take priority over this file.

# --- target model under test (DeepSeek V4 Flash) ---
# Run with: --target-model deepseek-v4-flash
# base_url defaults to https://api.deepseek.com automatically for any
# "deepseek*" model name, so DEEPSEEK_API_KEY alone is enough.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- DeepSeek "thinking" mode ---
# Thinking is ON by default upstream (bills reasoning tokens, adds latency).
# This repo disables it by default for any "deepseek*" model. To re-enable
# it (e.g. to study the target's real-world reasoning behavior), set:
# VDB_TARGET_DISABLE_THINKING=0

# --- optional: per-role overrides if judge/draft/classifier/plausibility ---
# --- need a different endpoint than the local vLLM servers in scripts/deploy ---
# VDB_JUDGE_API_KEY=EMPTY
# VDB_JUDGE_BASE_URL=http://127.0.0.1:8002/v1
# VDB_DRAFT_API_KEY=EMPTY
# VDB_DRAFT_BASE_URL=http://127.0.0.1:8001/v1

# --- generic fallback (any OpenAI-compatible endpoint, any persona) ---
# VDB_API_KEY=sk-xxxx
# VDB_BASE_URL=https://api.deepseek.com
